{
    "name": "what-should-i-play-next",
    "version": "0.3.0",
    "private": true,
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "dev": "vinext dev --hostname 127.0.0.1 --port 3000",
        "build": "vinext build",
        "start": "node scripts/start-server.ts --hostname 127.0.0.1 --port 3000",
        "start:production": "node scripts/start-server.ts --hostname 0.0.0.0 --port 3001",
        "package:windows": "node scripts/package-windows.mjs",
        "test:package": "node scripts/test-package.mjs",
        "startup:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows-startup.ps1 -Action Install",
        "startup:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows-startup.ps1 -Action Uninstall",
        "startup:linux:install": "bash scripts/linux-startup.sh install",
        "startup:linux:uninstall": "bash scripts/linux-startup.sh uninstall",
        "test": "node --test tests/*.test.ts",
        "typecheck": "tsc --noEmit",
        "check:codex": "node scripts/check-codex.ts",
        "check:flow": "node scripts/check-flow.ts",
        "sync:steam-tags": "node scripts/sync-steam-tags.ts",
        "lint": "oxlint",
        "format": "oxfmt",
        "format:prettier": "prettier --write \"{app,components,lib,scripts,tests}/**/*.{ts,tsx,js,jsx,json,css,scss,md}\""
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.30.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "vinext": "1.0.0-beta.9",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@base-ui/react": "1.7.0",
        "@shadcn/react": "0.3.0",
        "@tailwindcss/postcss": "4.2.1",
        "@types/node": "22.19.19",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.2",
        "@vitejs/plugin-rsc": "0.5.34",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "cmdk": "1.1.1",
        "date-fns": "4.1.0",
        "embla-carousel-react": "8.5.2",
        "input-otp": "1.4.2",
        "lucide-react": "1.31.0",
        "oxfmt": "0.61.0",
        "oxlint": "1.76.0",
        "oxlint-tsgolint": "7.0.2001",
        "prettier": "^3.9.6",
        "react-day-picker": "9.8.1",
        "react-resizable-panels": "4.5.8",
        "react-server-dom-webpack": "19.2.8",
        "recharts": "3.8.0",
        "shadcn": "4.18.0",
        "tailwindcss": "4.2.1",
        "tailwind-merge": "3.6.0",
        "tw-animate-css": "1.4.0",
        "typescript": "5.9.3",
        "vite": "8.2.2"
    },
    "type": "module"
}
